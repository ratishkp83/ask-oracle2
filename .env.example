# Copy this file to .env and fill in your values for local development.
# On Render, set these as Environment Variables in the dashboard instead.
#
# NOTE: Oracle connection credentials are NOT set here — they are entered in the UI /
# connection profiles. Always connect with a least-privilege, READ-ONLY Oracle account
# (CREATE SESSION + SELECT only; no DML; no EXECUTE on side-effecting packages).
# This is a required precondition for the "no data modification" guarantee — see
# docs/07-deployment-plan.md and docs/adr/ADR-009-readonly-db-account-precondition.md.

# --- LLM Provider (choose ONE) ---

# Option A: Groq (recommended — fast & free tier available)
GROQ_API_KEY=gsk_...your-groq-key-here...
GROQ_MODEL=llama3-70b-8192

# Option B: OpenAI (comment out GROQ_API_KEY above if using this)
# OPENAI_API_KEY=sk-...your-openai-key-here...
# OPENAI_MODEL=gpt-4o-mini

# --- Storage ---
STORAGE_DIR=/app/storage

# --- Secret encryption (REQUIRED to save/use connection profiles) ---
# Any passphrase works; it is hashed to derive a Fernet key. Generate a strong
# one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_SECRET_KEY=change-me-to-a-long-random-value

# --- Network / auth (Phase 6.5 / ADR-013) ---
# API-key authentication — required for ANY networked / non-localhost exposure.
# Set a strong random value. Leave blank to disable auth (localhost-only only).
APP_API_KEY=

# CORS allowed origins, comma-separated. Do NOT use "*" (forfeits credentials).
# Example: https://myapp.example.com,https://staging.example.com
# Blank falls back to localhost defaults.
ALLOWED_ORIGINS=

# --- LLM policy (Phase 3) ---
# Controls whether the AI (NL→SQL) sends queries to an external provider.
# Options: local_external (default) | local_only | external_disabled
# Use external_disabled to block all external LLM calls for sensitive environments.
LLM_POLICY=local_external

# --- PII scrubbing (Phase C1 / ITM-008) ---
# When truthy, masks email/SSN/card/phone in the NL question before an external
# LLM send. Opt-in — off by default; over-masking can degrade NL→SQL quality.
SCRUB_PII=false

# --- Logging (Phase 6 / ADR-012) ---
LOG_LEVEL=INFO
# json = structured stdout (12-factor, recommended for production)
# text = human-readable (local dev)
LOG_FORMAT=text

# --- Safety limits (optional; sensible defaults applied if unset) ---
MAX_ROWS=1000
MAX_EXECUTION_SECONDS=30
MAX_RESULT_BYTES=5000000

# --- Email follow-up action (Phase 8) ---
# Opt-in: the "Send as email" feature is OFF until SMTP_USER + SMTP_PASSWORD are set.
# For Gmail, SMTP_PASSWORD is an App Password (the account needs 2-Step Verification);
# spaces in the App Password are fine — they are stripped.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Optional "From" header; blank defaults to SMTP_USER.
EMAIL_FROM=
# Optional comma-separated recipient allow-list (e.g. corp.com,partner.com).
# Blank = allow any address; every send is audit-logged regardless.
EMAIL_ALLOWED_DOMAINS=
# Max RAW attachment size in MB (default 17; base64 inflates ~33%, so this keeps
# the encoded message under Gmail's 25 MB limit).
EMAIL_MAX_ATTACHMENT_MB=17
