# Copy this file to .env and fill in your values for local development.
# On Render, set these as Environment Variables in the dashboard instead.

# --- LLM Provider (choose ONE) ---

# Option A: Groq (recommended — fast & free tier available)
GROQ_API_KEY=gsk_...your-groq-key-here...
GROQ_MODEL=llama3-70b-8192

# Option B: OpenAI (comment out GROQ_API_KEY above if using this)
# OPENAI_API_KEY=sk-...your-openai-key-here...
# OPENAI_MODEL=gpt-4o-mini

# --- Storage ---
STORAGE_DIR=/app/storage

# --- Secret encryption (REQUIRED to save/use connection profiles) ---
# Any passphrase works; it is hashed to derive a Fernet key. Generate a strong
# one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_SECRET_KEY=change-me-to-a-long-random-value

# --- Safety limits (optional; sensible defaults applied if unset) ---
MAX_ROWS=1000
MAX_EXECUTION_SECONDS=30
MAX_RESULT_BYTES=5000000
